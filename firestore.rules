rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // --- Helpers ---
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return request.auth != null && 
             (request.auth.token.email == "sanajidul.muhsinin.tamim@gmail.com" ||
              request.auth.token.email == "babul28111979@gmail.com" ||
              request.auth.token.email == "babul 28111979@gmail.com");
    }
    
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'brand', 'category', 'description', 'regularPrice', 'salePrice', 'availability', 'imageUrl', 'createdAt']) &&
             data.name is string &&
             data.brand is string &&
             data.category is string &&
             data.description is string &&
             data.regularPrice is number &&
             data.salePrice is number &&
             data.availability is string &&
             data.imageUrl is string &&
             data.createdAt is number &&
             (!data.keys().hasAny(['unit']) || data.unit is string);
    }

    function isValidOfflineSale(data) {
      return data.keys().hasAll(['items', 'subtotal', 'discount', 'total', 'timestamp', 'customerLocation', 'deliveryHand']) &&
             data.items is list &&
             data.subtotal is number &&
             data.discount is number &&
             data.total is number &&
             data.timestamp is number &&
             data.customerLocation is string &&
             data.deliveryHand is string &&
             (!data.keys().hasAny(['customerName']) || data.customerName is string) &&
             (!data.keys().hasAny(['customerPhone']) || data.customerPhone is string) &&
             (!data.keys().hasAny(['discountCode']) || data.discountCode is string);
    }

    function isValidOnlineOrder(data) {
      return data.keys().hasAll(['customerInfo', 'items', 'subtotal', 'deliveryCharge', 'total', 'status', 'createdAt']) &&
             data.items is list && data.items.size() <= 100 &&
             data.subtotal is number &&
             data.deliveryCharge is number &&
             data.total is number &&
             data.status is string && data.status.size() <= 50 &&
             data.createdAt is number &&
             (!data.keys().hasAny(['userId']) || data.userId is string);
    }

    // --- Rules ---
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    match /offlineSales/{saleId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidOfflineSale(incoming());
      allow update: if isAdmin() && isValidOfflineSale(incoming());
      allow delete: if isAdmin();
    }

    match /onlineOrders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if isValidOnlineOrder(incoming());
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && 
                       incoming().keys().hasAll(['productId', 'userId', 'userName', 'rating', 'comment', 'createdAt']) &&
                       incoming().userId == request.auth.uid &&
                       incoming().rating is number &&
                       incoming().rating >= 1 && incoming().rating <= 5 &&
                       incoming().comment is string &&
                       incoming().productId is string &&
                       incoming().createdAt is number;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    match /qas/{qaId} {
      allow read: if true;
      allow create: if incoming().keys().hasAll(['productId', 'question', 'askedBy', 'askedById', 'createdAt']) &&
                       (request.auth == null || incoming().askedById == request.auth.uid) &&
                       incoming().question is string &&
                       incoming().productId is string &&
                       incoming().createdAt is number;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /storeSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
