{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An item in the store",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "regularPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "availability": { "type": "string", "enum": ["In Stock", "Pre Order", "Upcoming"] },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "brand", "category", "regularPrice", "salePrice", "availability", "imageUrl", "createdAt"]
    },
    "OfflineSale": {
      "title": "Offline Sale",
      "description": "A POS transaction",
      "type": "object",
      "properties": {
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "discountCode": { "type": "string" },
        "total": { "type": "number" },
        "timestamp": { "type": "number" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerLocation": { "type": "string" },
        "deliveryHand": { "type": "string" }
      },
      "required": ["items", "subtotal", "discount", "total", "timestamp", "customerLocation", "deliveryHand"]
    },
    "OnlineOrder": {
      "title": "Online Order",
      "description": "An order placed online",
      "type": "object",
      "properties": {
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "gateway": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["items", "total", "status", "gateway", "customerName", "phone", "timestamp"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback on products",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["productId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "Qa": {
      "title": "QA",
      "description": "Product Questions and Answers",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "question": { "type": "string" },
        "askedBy": { "type": "string" },
        "askedById": { "type": "string" },
        "createdAt": { "type": "number" },
        "answer": { "type": "string" },
        "answeredBy": { "type": "string" },
        "answeredAt": { "type": "number" }
      },
      "required": ["productId", "question", "askedBy", "askedById", "createdAt"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Store products"
    },
    "offlineSales/{saleId}": {
      "schema": { "$ref": "#/entities/OfflineSale" },
      "description": "Offline POS transactions"
    },
    "onlineOrders/{orderId}": {
      "schema": { "$ref": "#/entities/OnlineOrder" },
      "description": "Online customer orders"
    },
    "reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Store user ratings and reviews"
    },
    "qas/{qaId}": {
      "schema": { "$ref": "#/entities/Qa" },
      "description": "Store user product questions and admin answers"
    }
  }
}
